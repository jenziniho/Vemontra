# Copy this file to ".env.local" and fill it in. On Vercel, add the same values under Settings → Environment Variables.

# Sanity (https://www.sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Secret shared with the Sanity webhook, so published changes show up immediately — see README, step 4
SANITY_REVALIDATE_SECRET=

# Contact form e-mails via Resend (https://resend.com) — see README, step 5
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="Vemontra website <website@vemontra.be>"
